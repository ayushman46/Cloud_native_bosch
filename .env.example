# Copy to .env. Mock mode (the default) needs nothing else.
MODE=mock
CHAOSAI_HOST_API_PORT=8000
CHAOSAI_HOST_DASHBOARD_PORT=5173

# ---- Real mode (docker-compose.real.yml): set these, then follow the README ----
# Both secrets are random strings you invent. CHAOSAI_API_KEY is what you type into the dashboard.
CHAOS_CONTROL_API_KEY=change-me-controller-secret
CHAOSAI_API_KEY=change-me-dashboard-secret
REAL_INJECTIONS_ENABLED=false
# NVIDIA-hosted LLM: plans the experiment and writes the diagnosis. Leave empty to use deterministic fallbacks.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---- Safety limits (the controller enforces the same limits independently) ----
ALLOWED_TARGETS=openmeter,sink-worker,kafka,clickhouse,redis,postgres
MAX_DURATION_SECONDS=30
MAX_LATENCY_MS=2000
MAX_RPS=20
BASELINE_SECONDS=3
RECOVERY_SECONDS=10
POLL_SECONDS=1

# ---- Set automatically by docker-compose.real.yml; only edit for a non-compose setup ----
OPENMETER_BASE_URL=
OPENMETER_HEALTH_PATH=/api/v1/debug/metrics
ENABLE_SYNTHETIC_EVENTS=false
OPENMETER_METER_SLUG=api_requests_total
OPENMETER_INGEST_PATH=
OPENMETER_QUERY_PATH=
CHAOS_CONTROL_URL=
DATABASE_PATH=./chaosai.sqlite3
FRONTEND_ORIGIN=http://localhost:5173
