MODE=mock
CHAOSAI_HOST_API_PORT=8000
CHAOSAI_HOST_DASHBOARD_PORT=5173
REAL_INJECTIONS_ENABLED=false
OPENMETER_BASE_URL=
OPENMETER_HEALTH_PATH=/api/v1/debug/metrics
ENABLE_SYNTHETIC_EVENTS=false
OPENMETER_METER_SLUG=api_requests_total
OPENMETER_INGEST_PATH=
OPENMETER_QUERY_PATH=
CHAOS_CONTROL_URL=
CHAOS_CONTROL_API_KEY=
CHAOSAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=
ALLOWED_TARGETS=openmeter,sink-worker
BASELINE_SECONDS=3
RECOVERY_SECONDS=10
POLL_SECONDS=1
MAX_DURATION_SECONDS=30
MAX_LATENCY_MS=2000
MAX_RPS=20
DATABASE_PATH=./chaosai.sqlite3
FRONTEND_ORIGIN=http://localhost:5173
