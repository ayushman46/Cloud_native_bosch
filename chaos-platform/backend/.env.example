# --- OpenMeter sandbox (defaults match openmeter/quickstart/docker-compose.yaml) ---
OPENMETER_BASE_URL=http://127.0.0.1:48888
# OPENMETER_API_KEY=
OPENMETER_METER_SLUG=api_requests_total
OPENMETER_EVENT_TYPE=request
SINK_WORKER_HEALTH_URL=http://127.0.0.1:40000/healthz
BALANCE_WORKER_HEALTH_URL=http://127.0.0.1:40001/healthz

# --- NVIDIA hosted LLM (Analyzer only; Observer never needs it) ---
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
